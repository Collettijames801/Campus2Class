# Copy this file to .env and fill in real values before running.

PORT=4000

# Get these from developer.paypal.com after creating a Business account + app.
# Use your Sandbox app credentials while testing, then swap to Live credentials at launch.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# A password you make up yourself, used to protect the /api/bookings admin endpoint.
ADMIN_KEY=change_me_to_something_private

# Required for tutor JWTs and first-tutor setup.
JWT_SECRET=replace_with_a_long_random_secret
TUTOR_SETUP_KEY=replace_with_a_separate_setup_key

# Resend confirmation email settings. EMAIL_FROM must use a verified domain.
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=Campus2Class <bookings@your-domain.com>
